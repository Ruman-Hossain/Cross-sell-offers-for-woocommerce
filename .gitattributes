# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary assets that must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mo binary

# Keep development-only files out of release archives.
.gitattributes export-ignore
.gitignore export-ignore
